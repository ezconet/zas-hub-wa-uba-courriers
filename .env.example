# WhatsApp
WA_GROUP_JID=              # JID do grupo de motoboys (ex: 5512999990000-1234567890@g.us)
WA_HEALTH_GROUP_JID=       # JID do grupo de validação (só operador)
OWNER_JID=                 # JID do dono para msgs de status (ex: 5512999990000@s.whatsapp.net)

# ZasHub
ZASHUB_WEBHOOK_URL=        # URL base (ex: https://zashub.com.br/api)
ZASHUB_WEBHOOK_SECRET=     # Secret validado por ZasHub em header x-webhook-secret

# API Security
API_SECRET=                # Header x-api-key obrigatório em todos endpoints

# AWS S3 (upload QR code na reconexão)
AWS_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email (notificação de reconexão)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# App
PORT=3001
AUTH_PATH=./auth/baileys_auth
DB_PATH=./data/state.db
DISPATCH_QUEUE_WINDOW_MS=4000
LOG_LEVEL=info            # debug | info | warn | error
