# WhatsApp
WA_GROUP_JID=              # JID do grupo de motoboys (ex: 5512999990000-1234567890@g.us)
WA_HEALTH_GROUP_JID=       # JID do grupo de validação (só operador)
OWNER_JID=                 # JID do dono para msgs de status (ex: 5512999990000@s.whatsapp.net)

# ZasHub
ZASHUB_WEBHOOK_URL=        # URL base (ex: https://zashub.com.br/api)
ZASHUB_WEBHOOK_SECRET=     # Secret validado por ZasHub em header x-webhook-secret

# Spec 099 — guard de elegibilidade antes do react 👍 (GET {ZASHUB_WEBHOOK_URL}/dispatch/order-status)
REACT_GUARD_ENABLED=true   # true = consulta Hub e só reage se pedido READY (fail-closed). false = rollback
REACT_GUARD_TIMEOUT_MS=3000 # timeout da consulta; em timeout/erro NÃO reage
REACT_DRY_RUN=true         # true = NÃO aplica 👍, só loga winner (marca manual). false = reage de verdade

# API Security
API_SECRET=                # Header x-api-key obrigatório em todos endpoints

# AWS S3 (upload QR code na reconexão) — objeto PRIVADO, URL presigned
AWS_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_QR_KEY=courrier-notify/qr.png   # key fixa (sobrescreve, sem acúmulo)
QR_PRESIGN_TTL_S=900                    # validade da URL presigned (15min)

# SNS (notificação de QR por email — configure subscription topic→email no AWS)
SNS_TOPIC_ARN=

# Email SMTP (fallback opcional de QR — prefira SNS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# App
PORT=3001
AUTH_PATH=./auth/baileys_auth
DB_PATH=./data/state.db
DISPATCH_QUEUE_WINDOW_MS=4000
# Anti "eu" de outro comércio no mesmo grupo:
# (principal) plain "eu" enviado ANTES do nosso announce não é do nosso pedido → rejeita.
PLAIN_EU_REQUIRE_AFTER_ANNOUNCE=true
PLAIN_EU_AFTER_GRACE_MS=5000   # folga p/ skew de relógio (waTimestamp WA vs sent_at)
# (secundário, opcional) plain "eu" só conta se announce for mais novo que isto. 0 = off.
PLAIN_EU_MAX_AGE_MS=0
LOG_LEVEL=info            # debug | info | warn | error

# Watchdog de "grupo mudo" (sender-keys quebradas → msgs não decifram)
WA_PROBE_GROUP_JID=          # grupo de TESTE p/ probe (≠ WA_GROUP_JID); vazio = desativado
MUTE_UNDECRYPTED_THRESHOLD=3 # stub=2 consecutivos do grupo real p/ levantar suspeita
MUTE_PROBE_WAIT1_MS=300000   # espera após 1º probe (5min)
MUTE_PROBE_WAIT2_MS=120000   # espera após 2º probe (2min)
